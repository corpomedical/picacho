<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup=false: everything real lives on the server, so a device
         backup would carry nothing worth restoring — except the WebView's
         cookies, i.e. the Supabase session token, riding into cloud backups
         and device-to-device transfers. Signing in again is cheaper than
         letting an auth token travel. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <!-- Package-visibility declarations (Android 11+). The web app's "Take
         photo" control is <input type="file" capture="environment">, which
         Capacitor CORE serves by resolving MediaStore.ACTION_IMAGE_CAPTURE
         (BridgeWebChromeClient.showImageCapturePicker) — and on API 30+ that
         resolve returns null unless the action is declared here, in which
         case core logs "Media capture intent could not be launched" and
         quietly opens the gallery instead. Until versionCode 12 these three
         rode in on @capacitor/camera's manifest; that plugin was never called
         and is now excluded (capacitor.config.ts), so the declarations live
         where the feature that needs them lives. Measured, not assumed:
         without this block the tap opened the Photopicker; with it, the
         camera. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PICK" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ (API 33) shows no notifications unless the app BOTH
         declares this permission and is granted it at runtime. The runtime
         half is done by the Capacitor push plugin (native-push.tsx calls
         requestPermissions() after sign-in); this declaration is the manifest
         half — without it that runtime prompt is auto-denied and the
         "render finished" pushes silently never arrive on any modern device.
         Neither the plugin's own manifest nor firebase-messaging declares it
         for us. Not declared: CAMERA — reference-photo capture goes through
         the web <input capture> bridge, which delegates to the system camera
         app precisely so no camera permission is needed (see
         BridgeWebChromeClient.isMediaCaptureSupported). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
