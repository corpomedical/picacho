<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- The launch field. Matches the web intro sheet exactly, so the
             system splash and the page that replaces it are one surface
             (versionCode 6). -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>

        <!-- THE ONE THAT MATTERS (versionCode 7). Unset, this attribute
             defaults to @null and Android falls back to android:icon — which
             is why versionCode 5 and 6 both showed a motionless launcher icon
             for the entire cold start. Naming an ANIMATED drawable here is
             what turns the mandatory launch phase from "frozen, looks
             crashed" into "moving, looks like it's working".

             Deliberately the androidx attr with NO android: prefix: the
             core-splashscreen theme forwards it to the platform attribute on
             API 31+ (verified in the .aar's values-v31.xml) AND uses it for
             the compat starting window below that, so one line covers every
             API level this app supports. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <!-- Required to be > 0 whenever the icon is animated. Metadata for
             the platform, not a timer: it does not lengthen or shorten how
             long the splash stays up. -->
        <item name="windowSplashScreenAnimationDuration">1000</item>

        <!-- Pre-Android-12 starting window. Kept for API 24-30, where the
             system splash above does not exist. -->
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>