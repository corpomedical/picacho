<?xml version="1.0" encoding="utf-8"?>
<!-- Round-mask variant. Identical layers to ic_launcher.xml by design: the
     adaptive-icon system applies the device's own mask, so the two differ
     only in which launchers request them. See ic_launcher.xml for why
     <monochrome> is here. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
