<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications. "development" is what Xcode builds with; an
	     archive exported for TestFlight or the App Store is re-signed with
	     "production" from the distribution profile. The server sends each
	     token to the matching APNs host (src/lib/push/apns.ts). -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
