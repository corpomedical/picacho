# Copy this file to .env.local and fill in real values as each service gets connected.
# .env.local is where secret keys live — it's in .gitignore, so it never gets uploaded to GitHub.
#
# FORMAT RULES (a malformed .env.local silently breaks local dev — real
# incident, 2026-08-10: a key had been pasted onto its own line with no
# NAME= in front of it, so the app saw no OpenAI key at all):
#   - every line is NAME=value, with no spaces around the =
#   - don't wrap values in quotes unless the value itself contains spaces
#   - a line with no = is ignored entirely, key and all
#
# Production does NOT read this file. Vercel has its own copy of every
# variable below under Project > Settings > Environment Variables — changing
# one there requires a redeploy to take effect.

# --- Supabase (database, auth, storage) ---
# All three are in the Supabase dashboard under Project Settings > API.
# The service-role key bypasses row-level security — server-side only, never
# expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site URL ---
# Used to build absolute links (Stripe checkout returns, OG tags, sitemap).
# Locally this is http://localhost:3000; in production it's https://picacho.ai
NEXT_PUBLIC_SITE_URL=

# --- Stripe (billing) ---
# Secret key: dashboard.stripe.com > Developers > API keys.
# Webhook secret: created with the webhook endpoint itself — starts with whsec_
# Test-mode keys (sk_test_/whsec_) are the right ones for local work.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI providers ---
# Draft step. Get a key at console.anthropic.com
ANTHROPIC_API_KEY=
# Review step, image generation (GPT Image 2), and voice mode's speech
# replies. Get a key at platform.openai.com > API keys. The account needs
# billing set up — a key on a zero-balance account authenticates fine and
# then fails on every actual call.
OPENAI_API_KEY=
# Optional — defaults to gpt-5.4-mini if not set. Leave blank to use the
# default; an empty value is fine, a missing = is not.
OPENAI_MODEL=
# Generate step (video). Get a key at fal.ai — one key covers every model
# in the switcher under Admin > AI Providers (Kling, Veo, ...)
FAL_KEY=
#
# These only take effect once the 'real_ai_providers' flag is turned on in
# Admin > Feature flags — until then the app uses the mock pipeline and none
# of this needs to be filled in.

# --- Search Console (optional) ---
# The content="..." value from Google's HTML-tag verification method.
# Only needed to re-verify ownership; leave blank otherwise.
GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Everything below was read by the code but missing from this file until
# 2026-09-08 — 22 variables, found by diffing process.env.* in src/ against
# the names here. A fresh environment set up from this file would have had
# no cron, no email, no push, no media signing and no BytePlus lane, each
# failing quietly in its own way. Blank behaviour is stated per variable so
# nobody has to read the code to learn what silence means.
# ---------------------------------------------------------------------------

# --- Scheduled jobs ---
# Vercel Cron sends `Authorization: Bearer <this>` to /api/cron/*. Blank means
# every cron call answers 401 — reconcile, drip and reels simply never run.
# Any long random string; set the same value in Vercel > Cron.
CRON_SECRET=

# --- Email (Resend) ---
# resend.com > API keys. Blank: sendEmail logs a warning and returns an error;
# nothing is sent, and Admin > Emails shows email as not configured.
RESEND_API_KEY=
# Sender shown in inboxes. Optional — defaults to "Picacho <hello@picacho.ai>";
# whatever is set must be on the domain verified in Resend.
EMAIL_FROM=
# Signs the one-click unsubscribe links. Optional — falls back to
# SUPABASE_SERVICE_ROLE_KEY, but a dedicated secret means rotating the
# service role key does not invalidate every unsubscribe link in flight.
EMAIL_UNSUBSCRIBE_SECRET=

# --- Media URLs ---
# Signs /api/media/... capability links (the ?v= on every stored file).
# Optional — falls back to SUPABASE_SERVICE_ROLE_KEY. Same rotation logic
# as EMAIL_UNSUBSCRIBE_SECRET: a dedicated secret keeps existing links alive
# across a service-key rotation.
MEDIA_SIGNING_SECRET=

# --- Push notifications ---
# Web push (VAPID). Generate a pair once (`npx web-push generate-vapid-keys`)
# and never change it — subscriptions are bound to the public key. Blank:
# web push is silently off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# The contact address browsers may use about the push server. Optional —
# defaults to mailto:hello@picacho.ai.
VAPID_SUBJECT=
# Android push through Firebase Cloud Messaging: the project id and the
# service-account JSON (the whole file, on one line) from Firebase console >
# Project settings > Service accounts. Blank: Android pushes are silently
# dropped, web push unaffected.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# --- fal.ai, beyond FAL_KEY ---
# An ADMIN-scope key for the balance card on Admin > Stats and the ledger
# reconciliation on Admin > AI providers. Deliberately separate from FAL_KEY:
# admin scope also covers CLI and deployment, and the render path has no
# business holding that. Blank: the balance card says why, renders unaffected.
FAL_ADMIN_KEY=
# The account id fal sends as x-fal-webhook-user-id. The webhook rejects
# callbacks from any other account, so a signed callback for someone else's
# job can never complete one of ours. Read it off the first genuine callback
# in the logs; blank means the check is skipped (fail-open — set it).
FAL_ACCOUNT_ID=

# --- BytePlus ModelArk (Seedance direct lane) ---
# console.byteplus.com > ModelArk > API keys. Blank: the lane shows as
# "missing" on Admin > AI providers and every Seedance render takes the fal
# route instead.
BYTEPLUS_ARK_API_KEY=
# "on" enables the direct lane (with the key above); anything else keeps
# Seedance on fal. Admin > AI providers shows which lane is live.
BYTEPLUS_SEEDANCE_LANE=
# Path segment of the ModelArk callback URL, /api/webhooks/byteplus/<this>.
# Blank: the webhook refuses every call and direct-lane renders wait for a
# callback that is never accepted — set it before turning the lane on.
BYTEPLUS_WEBHOOK_SECRET=

# --- Stripe, client side ---
# pk_live_/pk_test_ from the same dashboard page as STRIPE_SECRET_KEY. Blank:
# the embedded checkout page cannot mount Stripe at all.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Play Billing (RevenueCat), paused ---
# The plugin is excluded from the Android binary (capacitor.config.ts), so
# neither of these does anything today. Documented so the day the store is
# switched back on, the two halves are known: the public SDK key, and the
# Authorization header value RevenueCat is configured to send to
# /api/webhooks/revenuecat.
NEXT_PUBLIC_REVENUECAT_GOOGLE_KEY=
REVENUECAT_WEBHOOK_AUTH=

# --- Kill switches ---
# "1" hides the Google/Facebook buttons inside the Android app for every
# installed build on the next request — no deploy, no store round trip. Set
# it only when the CURRENT build's sign-in is misbehaving; retiring an old
# build is the user-agent token's job (lib/native/platform.ts).
NATIVE_OAUTH_DISABLED=
# "1" turns the assistant chat off everywhere. Same shape as above.
AGENT_CHAT_DISABLED=

# --- Showcase (homepage proof clips) ---
# Which character and owner the public showcase draws from. Optional —
# default to the production Eva character and its owner (lib/showcase.ts).
# Only needed when a different account should feed the homepage.
SHOWCASE_CHARACTER_ID=
SHOWCASE_OWNER_ID=
